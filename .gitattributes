# 统一换行，消除 Windows Git `LF will be replaced by CRLF` 警告
* text=auto eol=lf

# 明确按 LF 处理的文本
*.rs      text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.sh      text eol=lf
*.py      text eol=lf
*.sql     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.proto   text eol=lf
*.asc     text eol=lf

# Windows 专用脚本用 CRLF
*.ps1     text eol=crlf
*.bat     text eol=crlf

# 二进制文件不做换行转换
*.png     binary
*.jpg     binary
*.ico     binary
*.woff    binary
*.woff2   binary
